FROM python:3.10-bullseye

# python:3.10-bullseye already ships git 2.30.2, so this image never needed an
# apt install. Keeping one made the build fail outright once bullseye reached
# EOL and deb.debian.org's bullseye-security Release file expired:
#   E: Release file ... is expired (invalid since ...)
RUN git clone https://github.com/sympy/sympy.git /workspace/sympy \
    && cd /workspace/sympy \
    && git checkout 88664e6e0b781d0a8b5347896af74b555e92891e \
    && pip install --no-cache-dir -e . pytest

WORKDIR /workspace/sympy
