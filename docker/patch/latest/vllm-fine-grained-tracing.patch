+        self.emit_span(
+            "vllm.request.wait_remote_kv",
+            self.async_kv_load_start_time_ns,
+            now,
+            attributes,
+        )
+        self.async_kv_load_start_time_ns = None
+
+    def trace_end_prefill(self, aborted: bool = False) -> None:
+        """Transition request out of prefill. Closes vllm.request.prefill span."""
+        if self.prefill_start_time_ns is None:
+            return
+
+        now = time.time_ns()
+        attributes = {"aborted": True} if aborted else None
+        self.emit_span(
+            "vllm.request.prefill", self.prefill_start_time_ns, now, attributes
+        )
+        self.prefill_start_time_ns = None
+
+    def trace_end_decode(self, aborted: bool = False) -> None:
+        """Transition request out of decode. Closes vllm.request.decode span."""
+        if self.decode_start_time_ns is None:
