+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""per-request transfer metrics must survive a MultiConnector wrapper.
+
+``KVConnectorWorkerMetadata.get_request_metrics()`` is consumed by
+``vllm/v1/core/sched/scheduler.py`` to accumulate ``request.kv_transfer_metrics``.
+When a MultiConnector is configured the worker metadata that reaches the
+scheduler is a ``MultiKVConnectorWorkerMetadata``, so the wrapper has to forward
+what its children report; otherwise every metric is dropped silently.
+
+These tests drive the real classes: ``NixlRequestMetrics`` as the child and
+``MultiKVConnectorWorkerMetadata`` as the wrapper.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import pytest
+
+from vllm.distributed.kv_transfer.kv_connector.v1.multi_connector import (
+    MultiKVConnectorWorkerMetadata,
+)
+from vllm.distributed.kv_transfer.kv_connector.v1.nixl.metadata import (
+    NixlRequestMetrics,
+)
+
+
+def _wrap(*children: NixlRequestMetrics | None) -> MultiKVConnectorWorkerMetadata:
+    return MultiKVConnectorWorkerMetadata(metadata=tuple(children))
+
+
+def test_single_source_is_passed_through_unchanged():
+    wrapper = _wrap(NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 4096.0}}))
+    assert wrapper.get_request_metrics() == {"req-a": {"kv_transfer_bytes": 4096.0}}
+
+
+def test_none_children_are_skipped_without_dropping_the_others():
+    kept = NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 4096.0}})
+    expected = {"req-a": {"kv_transfer_bytes": 4096.0}}
+    assert _wrap(None, kept).get_request_metrics() == expected
+    assert _wrap(kept, None).get_request_metrics() == expected
+
+
+def test_distinct_request_ids_are_merged_not_crossed():
+    wrapper = _wrap(
