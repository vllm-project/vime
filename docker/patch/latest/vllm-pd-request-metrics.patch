+        NixlRequestMetrics({"req-b": {"kv_transfer_bytes": 512.0}}),
+    )
+    assert wrapper.get_request_metrics() == {
+        "req-a": {"kv_transfer_bytes": 4096.0},
+        "req-b": {"kv_transfer_bytes": 512.0},
+    }
+
+
+def test_same_request_different_fields_are_unioned():
+    wrapper = _wrap(
+        NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 4096.0}}),
+        NixlRequestMetrics({"req-a": {"handshake_wait_time": 0.25}}),
+    )
+    assert wrapper.get_request_metrics() == {"req-a": {"kv_transfer_bytes": 4096.0, "handshake_wait_time": 0.25}}
+
+
+def test_colliding_field_is_reported_once_and_not_summed(caplog):
+    """Two connectors claiming one name must not be added together.
+
+    Their transfers are not known to be disjoint, so the first owner is kept and
+    the collision is logged instead of inventing a total.
+    """
+    wrapper = _wrap(
+        NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 4096.0}}),
+        NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 512.0}}),
+    )
+    with caplog.at_level(logging.WARNING):
+        metrics = wrapper.get_request_metrics()
+    assert metrics == {"req-a": {"kv_transfer_bytes": 4096.0}}
+    assert any("more than one connector" in record.getMessage() for record in caplog.records)
+
+
+def test_identical_values_from_two_connectors_are_not_counted_twice():
+    wrapper = _wrap(
+        NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 4096.0}}),
+        NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 4096.0}}),
+    )
+    assert wrapper.get_request_metrics() == {"req-a": {"kv_transfer_bytes": 4096.0}}
+
+
+def test_empty_children_yield_no_metrics():
+    assert _wrap(None, NixlRequestMetrics({})).get_request_metrics() == {}
+
+
+def test_repeated_reads_do_not_accumulate():
+    wrapper = _wrap(NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 4096.0}}))
+    first = wrapper.get_request_metrics()
+    second = wrapper.get_request_metrics()
+    assert first == second == {"req-a": {"kv_transfer_bytes": 4096.0}}
+
+
+def test_reading_does_not_mutate_the_child():
+    child = NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 4096.0}})
+    _wrap(child).get_request_metrics()
+    assert child.get_request_metrics() == {"req-a": {"kv_transfer_bytes": 4096.0}}
+
+
+def test_metrics_missing_for_a_request_are_absent_rather_than_zero():
+    wrapper = _wrap(
+        NixlRequestMetrics({"req-a": {"kv_transfer_bytes": 4096.0}}),
+        NixlRequestMetrics({}),
+    )
+    assert wrapper.get_request_metrics() == {"req-a": {"kv_transfer_bytes": 4096.0}}
+
