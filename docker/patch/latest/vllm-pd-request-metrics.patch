@@ -67,6 +67,40 @@ class MultiKVConnectorWorkerMetadata(KVConnectorWorkerMetadata):
 
         return MultiKVConnectorWorkerMetadata(metadata=tuple(metadata_list))
 
+    def get_request_metrics(self) -> dict[str, dict[str, float]]:
+        """Forward the per-request metrics reported by each child metadata.
+
+        Without this override the wrapper inherits the no-op default from
+        ``KVConnectorWorkerMetadata``, so the scheduler sees no per-request
+        transfer metrics at all whenever a MultiConnector is configured.
+
+        The children are distinct connector types, so a metric name claimed by
+        more than one of them cannot be assumed to describe disjoint transfers.
+        Such a collision is therefore not summed: the first owner wins and the
+        collision is logged, so the combination rule stays visible instead of
+        silently double counting.
+        """
+        merged: dict[str, dict[str, float]] = {}
+        for child in self.metadata:
+            if child is None:
+                continue
+            for request_id, metrics in child.get_request_metrics().items():
+                target = merged.setdefault(request_id, {})
+                for name, value in metrics.items():
+                    if name in target:
+                        if target[name] != value:
+                            logger.warning(
+                                "MultiConnector: request %s reports %s from more than "
+                                "one connector (%s vs %s); keeping the first value",
+                                request_id,
+                                name,
+                                target[name],
+                                value,
+                            )
+                        continue
+                    target[name] = value
+        return merged
+
 
