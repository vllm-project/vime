+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""ROCm: open one HIP IPC handle before the first CuMemAllocator allocation.
+
+If the first hipIpcOpenMemHandle of a process that sees more than one GPU comes after
+its VMM allocations, KFD keeps both processes' queues evicted until the importer exits.
+"""
+
+import base64
+import pickle
+import subprocess
+import sys
+
+import torch
+from torch.multiprocessing.reductions import rebuild_cuda_tensor
+
+from vllm.config import VllmConfig
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_EXPORTER = r"""
+import base64, pickle, sys
+import torch
+from torch.multiprocessing.reductions import reduce_tensor
+torch.cuda.set_device(int(sys.argv[1]))
+buf = torch.ones(1 << 21, dtype=torch.uint8, device="cuda")
+torch.cuda.synchronize()
+sys.stdout.buffer.write(base64.b64encode(pickle.dumps(reduce_tensor(buf)[1])) + b"\n")
+sys.stdout.flush()
+sys.stdin.readline()
+"""
+
+
+def maybe_warm_up_ipc_import(vllm_config: VllmConfig, device: torch.device) -> None:
+    config = vllm_config.weight_transfer_config
+    if config is None or config.backend != "ipc" or torch.cuda.device_count() < 2:
+        return
+    exporter = subprocess.Popen(
+        [sys.executable, "-c", _EXPORTER, str(device.index)],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+    )
+    try:
+        args = list(pickle.loads(base64.b64decode(exporter.stdout.readline())))
+        args[6] = device.index
+        imported = rebuild_cuda_tensor(*args)
+        torch.cuda.synchronize(device)
+        del imported
+        torch.cuda.ipc_collect()
+    except Exception:
+        logger.warning(
+            "ROCm IPC warm-up import failed; IPC weight updates may stall.",
+            exc_info=True,
+        )
+    finally:
+        exporter.communicate(b"\n", timeout=60)
