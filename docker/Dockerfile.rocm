# vime on AMD ROCm (gfx950): base ships inference (ROCm/torch/triton/aiter/fa/vLLM), this adds training.
# Build: DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.rocm -t vllm/vime-rocm:latest .

# Pinned by digest. Its vLLM commit must accept docker/patch/latest/ (today: VLLM_COMMIT in docker/Dockerfile).
ARG BASE_IMAGE=vllm/vllm-openai-rocm:nightly-rocm100-83c078d955cd6e0c63d3b12abe669c8de936a370@sha256:d92e7eb1171463b6a653eb0573e64ffdab15b668a26b3bef24b469914c707174
FROM ${BASE_IMAGE}

# ======================================== Arguments =============================================

ARG PATCH_VERSION=latest
ARG MEGATRON_COMMIT=1dcf0dafa884ad52ffb243625717a3471643e087
ARG GPU_ARCH=gfx950

# ROCm's prebuilt apex, from the wheel index matching the base image's ROCm.
ARG ROCM_WHEEL_RELEASE=rocm-rel-7.2.3
ARG APEX_WHEEL=apex-1.10.0%2Brocm7.2.3.git751f5dd5-cp312-cp312-linux_x86_64.whl

ARG TE_TAG=v2.15_rocm
# CK fused attention is not built: it costs hours of compile time and TE falls
# back to the base image's flash-attn. Set to 1 to build it in.
ARG NVTE_FUSED_ATTN=0

# ROCm/HIP fork of torch_memory_saver (--offload-train).
ARG TMS_COMMIT=d64a639

# Named TE_MAX_JOBS, not MAX_JOBS: the base image sets ENV MAX_JOBS=16, and an
# inherited ENV shadows a same-named ARG inside RUN.
ARG TE_MAX_JOBS=64

WORKDIR /root/

# ======================================== Apt dependencies =============================================

# rsync backs command_utils.rsync_simple; the rest mirror docker/Dockerfile.
RUN apt-get update && apt-get install -y \
    rsync dnsutils iproute2 prometheus && \
    rm -rf /var/lib/apt/lists/*

# ======================================== TransformerEngine ===================

ENV NVTE_USE_ROCM=1
ENV NVTE_USE_HIPBLASLT=1
ENV NVTE_FRAMEWORK=pytorch

RUN --mount=type=cache,target=/root/.cache/ccache \
    git clone --depth 1 --branch ${TE_TAG} --recursive \
      https://github.com/ROCm/TransformerEngine.git /root/TransformerEngine && \
    cd /root/TransformerEngine && \
    NVTE_ROCM_ARCH=${GPU_ARCH} NVTE_FUSED_ATTN=${NVTE_FUSED_ATTN} \
    MAX_JOBS=${TE_MAX_JOBS} \
    pip install . --no-build-isolation && \
    ccache -s && \
    cd / && rm -rf /root/TransformerEngine

# ======================================== apex ================================

# Prebuilt against the same ROCm as the base image. Training runs pass
# --no-gradient-accumulation-fusion when apex is absent, so this is best-effort.
RUN pip install --no-deps --no-cache-dir \
      "https://repo.radeon.com/rocm/manylinux/${ROCM_WHEEL_RELEASE}/${APEX_WHEEL}" || \
    echo "WARN: apex install skipped/failed (train with --no-gradient-accumulation-fusion)"

# ======================================== Megatron-LM =========================

# NVIDIA/Megatron-LM + docker/amd_patch/. The fork-after-HIP-init checkpoint
# segfault is handled at runtime by vime.utils.rocm_checkpoint_writer.
RUN git clone https://github.com/NVIDIA/Megatron-LM.git --recursive /root/Megatron-LM && \
    cd /root/Megatron-LM && git checkout ${MEGATRON_COMMIT}

COPY docker/amd_patch/${PATCH_VERSION}/megatron.patch /root/Megatron-LM/
COPY docker/amd_patch/${PATCH_VERSION}/amd_megatron_fused_kernels_init.patch /root/Megatron-LM/
RUN cd /root/Megatron-LM && \
    git update-index --refresh && \
    git apply megatron.patch --3way && \
    git apply amd_megatron_fused_kernels_init.patch --3way && \
    if grep -R -n '^<<<<<<< ' .; then \
      echo "Patch failed to apply cleanly. Please resolve conflicts." && \
      exit 1; \
    fi && \
    rm megatron.patch amd_megatron_fused_kernels_init.patch && \
    pip install -e . --no-deps

# ====================================== Python dependencies ============================================

RUN pip install --no-cache-dir --ignore-installed PyJWT && \
    pip install --no-cache-dir flash-linear-attention==0.4.2

RUN pip install "git+https://github.com/fzyzcjy/torch_memory_saver.git@${TMS_COMMIT}" \
        --no-cache-dir --force-reinstall

COPY requirements.txt /tmp/vime-requirements.txt
RUN pip install --no-cache-dir -r /tmp/vime-requirements.txt

# Megatron asserts numpy 1.x; pin numpy/scipy/pyarrow back. pyarrow 25.0.1 is the newest
# that imports under numpy 1.26.4 (base's 26.0.0 is numpy-2-only) and still satisfies datasets>=24.
RUN pip install --no-cache-dir "numpy==1.26.4" "scipy==1.17.1" "pyarrow==25.0.1"


# ====================================== Patches ============================================

# The shared vLLM patches (read-only here), in docker/Dockerfile's order, with strict `git apply`
# (vLLM is a pip install). ROCm-only patches go in docker/amd_patch/.
COPY docker/patch/${PATCH_VERSION}/vllm-pull_weights.patch /tmp/vllm-pull_weights.patch
COPY docker/patch/${PATCH_VERSION}/vllm-score-centering.patch /tmp/vllm-score-centering.patch
COPY docker/patch/${PATCH_VERSION}/vllm-fine-grained-tracing.patch /tmp/vllm-fine-grained-tracing.patch
COPY docker/patch/${PATCH_VERSION}/vllm-generation-health.patch /tmp/vllm-generation-health.patch
COPY docker/patch/${PATCH_VERSION}/vllm-tensor-dump.patch /tmp/vllm-tensor-dump.patch
COPY docker/patch/${PATCH_VERSION}/vllm-deepgemm-bf16.patch /tmp/vllm-deepgemm-bf16.patch
COPY docker/patch/${PATCH_VERSION}/vllm-deepep-optional-shrink.patch /tmp/vllm-deepep-optional-shrink.patch
COPY docker/patch/${PATCH_VERSION}/vllm-glm5next-unbounded-gate.patch /tmp/vllm-glm5next-unbounded-gate.patch
COPY docker/patch/${PATCH_VERSION}/vllm-tito-columnar-logprobs-render.patch /tmp/vllm-tito-columnar-logprobs-render.patch
COPY docker/patch/${PATCH_VERSION}/vllm-watchdog-fatal-action.patch /tmp/vllm-watchdog-fatal-action.patch
RUN VLLM_SITE="$(python3 -c 'import os, vllm; print(os.path.dirname(os.path.dirname(vllm.__file__)))')" && \
    cd "$VLLM_SITE" && \
    git apply -v /tmp/vllm-pull_weights.patch && \
    git apply -v /tmp/vllm-score-centering.patch && \
    git apply -v /tmp/vllm-fine-grained-tracing.patch && \
    git apply -v /tmp/vllm-generation-health.patch && \
    git apply -v /tmp/vllm-tensor-dump.patch && \
    git apply -v /tmp/vllm-deepgemm-bf16.patch && \
    git apply -v /tmp/vllm-deepep-optional-shrink.patch && \
    git apply -v /tmp/vllm-glm5next-unbounded-gate.patch && \
    git apply -v /tmp/vllm-tito-columnar-logprobs-render.patch && \
    git apply -v /tmp/vllm-watchdog-fatal-action.patch && \
    rm /tmp/vllm-pull_weights.patch \
       /tmp/vllm-score-centering.patch \
       /tmp/vllm-fine-grained-tracing.patch \
       /tmp/vllm-generation-health.patch \
       /tmp/vllm-tensor-dump.patch \
       /tmp/vllm-deepgemm-bf16.patch \
       /tmp/vllm-deepep-optional-shrink.patch \
       /tmp/vllm-glm5next-unbounded-gate.patch \
       /tmp/vllm-tito-columnar-logprobs-render.patch \
       /tmp/vllm-watchdog-fatal-action.patch

# ====================================== Install main package ============================================

COPY . /root/vime
RUN cd /root/vime && pip install --no-cache-dir -e . --no-deps

RUN cd /root/vime/vime/backends/megatron_utils/kernels/int4_qat && \
    PYTORCH_ROCM_ARCH=${GPU_ARCH} pip install . --no-build-isolation

# ====================================== Runtime environment ============================================

RUN mkdir -p /opt/amdgpu/share/libdrm && \
    ln -sf /usr/share/libdrm/amdgpu.ids /opt/amdgpu/share/libdrm/amdgpu.ids 2>/dev/null || true

ENV CUDA_DEVICE_MAX_CONNECTIONS=1
ENV HSA_NO_SCRATCH_RECLAIM=1
# Pin aiter's codegen arch rather than sniffing the host. Its runtime dispatch
# still needs a device, so the check below stops short of megatron.training.
ENV GPU_ARCHS=${GPU_ARCH}
ENV VLLM_ROCM_USE_AITER=1
# /inference/v1/generate is gated behind `--enable-scale-out`, passed by
# backends/vllm_utils/vllm_engine.py (was VLLM_ENABLE_SCALE_OUT_ENDPOINTS).
ENV MIOPEN_DEBUG_CONV_DIRECT=0
ENV PYTHONPATH=/root/vime:/root/Megatron-LM

# docker build has no GPU, so this covers CPU-importable only; megatron.training and the
# train actor are covered by the ROCm Buildkite suites running this image on real MI355X.
RUN python3 -c "\
import torch, vllm, vime, transformer_engine, megatron.core; \
import fake_int4_quant_cuda; \
from vllm.distributed.weight_transfer.ipc_engine import IPCWeightTransferEngine; \
from vllm.entrypoints.scale_out.token_in_token_out.protocol import GenerateTokensChoice; \
from vime.backends.vllm_utils.vllm_engine import VLLMEngine; \
assert 'weight_versions' in GenerateTokensChoice.model_fields, 'vLLM base lacks per-choice weight_versions'; \
print('torch', torch.__version__, 'hip', torch.version.hip); \
print('vllm', vllm.__version__); \
print('transformer_engine', transformer_engine.__version__); \
print('vime import ok')"

# Reset the base's `vllm serve` ENTRYPOINT to a plain bash/ray env; else
# `docker run ... bash -c` and `ray job submit` append to `vllm serve` and break.
WORKDIR /root/vime
ENTRYPOINT []
# sleep infinity (not /bin/bash): `docker run -d` has no TTY so bash exits on EOF,
# killing the detached container. CI overrides this with --entrypoint bash.
CMD ["sleep", "infinity"]
