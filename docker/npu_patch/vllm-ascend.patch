+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Sparse HCCL weight transfer engine."""
+
+import logging
+import re
+from collections.abc import Iterator
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+import torch
+from vllm.config.weight_transfer import WeightTransferConfig
+from vllm.distributed.weight_transfer.base import (
+    WeightTransferEngine,
+    WeightTransferUpdateInfo,
+)
+
+from vllm_ascend.distributed.weight_transfer.hccl_engine import (
+    HCCLTrainerSendWeightsArgs,
+    HCCLWeightTransferEngine,
+    HCCLWeightTransferInitInfo,
+)
+from vllm_ascend.distributed.weight_transfer.sparse_weight_patch import (
+    SparseWeightPatch,
+    apply_sparse_hf_patches_with_loader,
+)
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+
+    from vllm_ascend.distributed.device_communicators.pyhccl import (
+        PyHcclCommunicator,
+    )
+
+__all__ = [
+    "SparseWeightPatch",
+    "SparseHCCLTrainerSendWeightsArgs",
+    "SparseHCCLWeightTransferUpdateInfo",
+    "SparseHCCLWeightTransferEngine",
+]
+
+
+@dataclass
+class SparseHCCLTrainerSendWeightsArgs(HCCLTrainerSendWeightsArgs):
+    """Arguments for broadcasting packed sparse HCCL updates."""
+
+
+@dataclass
+class SparseHCCLWeightTransferUpdateInfo(WeightTransferUpdateInfo):
+    """Update info for the sparse HCCL weight transfer backend."""
+
+    names: list[str]
+    dtype_names: list[str]
+    shapes: list[list[int]]
+    num_updates_list: list[int]
+    """Number of sparse entries to receive for each parameter in ``names``."""
+    encoding: str = "indices"
+    """``dense`` for the values-only seed, ``indices`` for steady deltas."""
+    checksum: int | None = None
+    """verl-compatible checksum over positions bytes and values."""
+    checksum_algorithm: str | None = None
+    """Checksum implementation used by the sender."""
+    verify: bool = False
+    """Verify sparse local writes, or check dense live-model idempotence."""
+    """Opt-in synchronized stage diagnostics; never synchronizes when false."""
+
+    def __post_init__(self) -> None:
+        if self.encoding not in {"dense", "indices"}:
+            raise ValueError(f"Unsupported sparse HCCL encoding: {self.encoding!r}")
+        if self.checksum_algorithm not in {None, "torch_hash_v1"}:
+            raise ValueError(f"Unsupported checksum algorithm: {self.checksum_algorithm!r}")
+        num_params = len(self.names)
+        if len(self.dtype_names) != num_params:
+            raise ValueError(
+                f"`dtype_names` should be of the same size as `names`: "
+                f"got {len(self.dtype_names)} and {len(self.names)}"
+            )
+        if len(self.shapes) != num_params:
+            raise ValueError(
+                f"`shapes` should be of the same size as `names`: "
+                f"got {len(self.shapes)} and {len(self.names)}"
+            )
+        if len(self.num_updates_list) == 0:
+            raise ValueError("`num_updates_list` cannot be empty for sparse updates")
+        if len(self.num_updates_list) != num_params:
+            raise ValueError(
+                f"`num_updates_list` should be of the same size as `names`: "
+                f"got {len(self.num_updates_list)} and {len(self.names)}"
+            )
+        if any(num_updates < 0 for num_updates in self.num_updates_list):
+            raise ValueError("Sparse `num_updates_list` entries must be non-negative")
+
+
+class SparseHCCLWeightTransferEngine(
+    WeightTransferEngine[
+        HCCLWeightTransferInitInfo,
+        SparseHCCLWeightTransferUpdateInfo,
+    ]
+):
+    """Apply sparse, flat-index weight patches received through HCCL."""
+
+    init_info_cls = HCCLWeightTransferInitInfo
+    update_info_cls = SparseHCCLWeightTransferUpdateInfo
+    supports_draft_weight_update = False
+
+    def __init__(
+        self,
+        config: WeightTransferConfig,
+        vllm_config: "VllmConfig",
+        device: torch.device,
+        model: torch.nn.Module,
+    ) -> None:
+        super().__init__(config, vllm_config, device, model)
+        self.model_update_group: PyHcclCommunicator | None = None
+
+    def init_transfer_engine(self, init_info: HCCLWeightTransferInitInfo) -> None:
+        """Initialize the HCCL process group with the trainer."""
+        dp_rank = self.parallel_config.data_parallel_index
+        world_size_per_dp = self.parallel_config.world_size
+        rank_within_dp = self.parallel_config.rank
+        worker_rank = dp_rank * world_size_per_dp + rank_within_dp
+        self.model_update_group = HCCLWeightTransferEngine._stateless_init_process_group(
+            init_info.master_address,
+            init_info.master_port,
+            worker_rank + init_info.rank_offset,
+            init_info.world_size,
+            device=torch.accelerator.current_device_index(),
+        )
+
+    def start_weight_update(self) -> None:
+        """Sparse patches use the model's TP/EP/PP-aware ownership rules."""
+
+    def finish_weight_update(self) -> None:
+        """Sparse runtime-format patches need no layerwise finalization."""
+        pass
+
+    def receive_weights(
+        self,
+        update_info: SparseHCCLWeightTransferUpdateInfo,
+    ) -> None:
+        """Receive sparse flat-index patches and apply them in place."""
+        if self.model_update_group is None:
+            raise RuntimeError(
+                "HCCL weight transfer not initialized. "
+                "Call init_transfer_engine() first."
+            )
+
+        num_updates_list = update_info.num_updates_list
+        total_updates = sum(num_updates_list)
+        dense = update_info.encoding == "dense"
+        packed_indices = torch.empty(
+            0 if dense else total_updates,
+            dtype=torch.int32,
+            device=self.device,
+        )
+        if not dense and packed_indices.numel():
+            self.model_update_group.broadcast(packed_indices, src=0, stream=torch.npu.current_stream())
+
+        # Values cannot be concatenated across different dtypes.  Keep one
+        # packed buffer per dtype instead, preserving first-seen dtype order so
+        # trainer and workers issue collectives in exactly the same sequence.
+        dtype_order = list(dict.fromkeys(update_info.dtype_names))
+        packed_values: dict[str, torch.Tensor] = {}
+        for dtype_name in dtype_order:
+            dtype_updates = sum(
+                num_updates
+                for patch_dtype, num_updates in zip(
+                    update_info.dtype_names,
+                    num_updates_list,
+                    strict=True,
+                )
+                if patch_dtype == dtype_name
+            )
+            values = torch.empty(
+                dtype_updates,
+                dtype=getattr(torch, dtype_name),
+                device=self.device,
+            )
+            if values.numel():
+                self.model_update_group.broadcast(values, src=0, stream=torch.npu.current_stream())
+            packed_values[dtype_name] = values
+
+        if update_info.checksum is not None:
+            if len(dtype_order) != 1:
+                raise ValueError("Checksummed sparse HCCL flushes must use one dtype")
+            positions = packed_indices.contiguous().view(torch.uint8)
+            values = packed_values[dtype_order[0]]
+            got = _delta_checksum(
+                positions,
+                values,
+                algorithm=update_info.checksum_algorithm or "torch_hash_v1",
+            )
+            if got != update_info.checksum:
+                raise RuntimeError(
+                    "Sparse HCCL checksum mismatch: "
+                    f"got {got}, expected {update_info.checksum}"
+                )
+
+        if dense:
+            value_offsets = dict.fromkeys(dtype_order, 0)
+            named_tensors = []
+            for name, dtype_name, expected_shape, num_updates in zip(
+                update_info.names,
+                update_info.dtype_names,
+                update_info.shapes,
+                num_updates_list,
+                strict=True,
+            ):
+                expected_numel = 1
+                for dimension in expected_shape:
+                    expected_numel *= dimension
+                if num_updates != expected_numel:
+                    raise ValueError(
+                        f"Dense seed size mismatch for {name}: "
+                        f"got {num_updates}, expected {expected_numel}"
+                    )
+                value_offset = value_offsets[dtype_name]
+                tensor = packed_values[dtype_name][
+                    value_offset : value_offset + num_updates
+                ].view(expected_shape)
+                value_offsets[dtype_name] = value_offset + num_updates
+                named_tensors.append((name, tensor))
+            if update_info.verify:
+                _verify_dense_load(self.model, named_tensors)
+            else:
+                self.model.load_weights(named_tensors)
+            return
+
+        index_offset = 0
+        value_offsets = dict.fromkeys(dtype_order, 0)
+        patches: list[tuple[SparseWeightPatch, list[int]]] = []
+        for name, dtype_name, expected_shape, num_updates in zip(
+            update_info.names,
+            update_info.dtype_names,
+            update_info.shapes,
+            num_updates_list,
+            strict=True,
+        ):
+            indices = packed_indices[index_offset : index_offset + num_updates]
+            value_offset = value_offsets[dtype_name]
+            values = packed_values[dtype_name][
+                value_offset : value_offset + num_updates
+            ]
+            index_offset += num_updates
+            value_offsets[dtype_name] = value_offset + num_updates
+            if _is_pipeline_missing_weight(self.model, name):
+                continue
+            patches.append(
+                (
+                    SparseWeightPatch(
+                        name=name,
+                        indices=indices,
+                        values=values,
+                    ),
+                    expected_shape,
+                )
+            )
+        apply_sparse_hf_patches_with_loader(
+            self.model,
+            patches,
+            direct_moe=True,
+            verify=update_info.verify,
+        )
+        if update_info.verify:
+            logging.getLogger(__name__).info(
+                "SPARSE-VERIFY local_patches=%d mismatch_elems=0", len(patches)
+            )
+
+    def shutdown(self) -> None:
+        if self.model_update_group is not None:
+            self.model_update_group = None
+
+    @staticmethod
+    def trainer_send_packed(
+        positions: torch.Tensor,
+        values: torch.Tensor,
+        args: HCCLTrainerSendWeightsArgs,
+    ) -> None:
+        """Send an assembled delta flush without another concatenation."""
+        if positions.dtype != torch.int32 or positions.ndim != 1 or values.ndim != 1:
+            raise ValueError("Packed delta requires flat int32 positions and flat values")
+        if positions.device != values.device or values.device.type != "npu":
+            raise ValueError("Packed HCCL buffers must reside on the same NPU")
+        if not positions.is_contiguous() or not values.is_contiguous():
+            raise ValueError("Packed HCCL buffers must be contiguous")
+        stream = args.stream or torch.npu.current_stream()
+        if positions.numel():
+            args.group.broadcast(positions, src=args.src, stream=stream)
+        if values.numel():
+            args.group.broadcast(values, src=args.src, stream=stream)
+        # The caller may release/reuse the buffers immediately after return.
+        stream.synchronize()
+
+    @staticmethod
+    def trainer_send_weights(
+        iterator: Iterator[SparseWeightPatch],
+        trainer_args: dict[str, Any] | HCCLTrainerSendWeightsArgs,
+    ) -> None:
+        """Broadcast sparse flat-index patches from trainer to workers."""
+        if isinstance(trainer_args, dict):
+            args = SparseHCCLTrainerSendWeightsArgs(**trainer_args)
+        else:
+            args = trainer_args
+        if args.packed:
+            raise ValueError(
+                "Sparse HCCL updates cannot be combined with `packed=True`"
+            )
+
+        patches = list(iterator)
+        if not patches:
+            return
+
+        stream = args.stream or torch.npu.current_stream()
+        packed_indices = torch.cat([patch.indices for patch in patches])
+        if packed_indices.numel():
+            args.group.broadcast(packed_indices, src=args.src, stream=stream)
+
+        # One values collective per dtype amortizes HCCL launch latency while
+        # retaining native parameter dtypes and avoiding byte-buffer alignment
+        # constraints.
+        dtype_order = list(dict.fromkeys(patch.values.dtype for patch in patches))
+        for dtype in dtype_order:
+            packed_values = torch.cat(
+                [patch.values for patch in patches if patch.values.dtype == dtype]
+            )
+            if packed_values.numel():
+                args.group.broadcast(packed_values, src=args.src, stream=stream)
+
+
+    trainer_init = staticmethod(HCCLWeightTransferEngine.trainer_init)
+
+
+def _delta_checksum(
+    positions: torch.Tensor,
+    values: torch.Tensor,
+    *,
+    algorithm: str = "torch_hash_v1",
+) -> int:
+    """Compute the negotiated payload checksum."""
+    if algorithm != "torch_hash_v1":
+        raise ValueError(f"Unsupported checksum algorithm: {algorithm!r}")
+    p = int(torch.hash_tensor(positions).item()) if positions.numel() else 0
+    v = int(torch.hash_tensor(values).item()) if values.numel() else 0
+    return (p ^ (v << 1)) & ((1 << 64) - 1)
+
+
+def _verify_dense_load(
+    model: torch.nn.Module,
+    named_tensors: list[tuple[str, torch.Tensor]],
+) -> None:
+    """Replay dense trainer state and require the live state to be unchanged."""
+    original_copy = torch.Tensor.copy_
+    mismatches: dict[str, int] = {}
+    skipped_nonlocal_experts = 0
+    skipped_nonlocal_pipeline = 0
+    verified_params = 0
+    for name, tensor in named_tensors:
+        touched: dict[tuple[int, int, torch.dtype], tuple[torch.Tensor, torch.Tensor]] = {}
+
+        def snapshot_then_copy(destination, source, *args, _touched=touched, **kwargs):
+            key = (destination.data_ptr(), destination.numel(), destination.dtype)
+            if key not in _touched:
+                _touched[key] = (destination, destination.detach().clone())
+            return original_copy(destination, source, *args, **kwargs)
+
+        torch.Tensor.copy_ = snapshot_then_copy
+        try:
+            model.load_weights([(name, tensor)])
+        finally:
+            torch.Tensor.copy_ = original_copy
+        if not touched and _is_pipeline_missing_weight(model, name):
+            skipped_nonlocal_pipeline += 1
+            continue
+        if not touched and ".experts." in name:
+            skipped_nonlocal_experts += 1
+            continue
+        if not touched:
+            raise RuntimeError(f"Dense verification did not touch any weight for {name}")
+        verified_params += 1
+        mismatch_count = 0
+        for destination, previous in touched.values():
+            if destination.is_floating_point() and destination.element_size() == 2:
+                mismatch_count += int(
+                    (destination.view(torch.int16) != previous.view(torch.int16)).sum()
+                )
+            else:
+                mismatch_count += int((destination != previous).sum())
+        if mismatch_count:
+            mismatches[name] = mismatch_count
+    if mismatches:
+        offenders = sorted(mismatches.items(), key=lambda item: -item[1])[:12]
+        raise RuntimeError(
+            "Sparse HCCL delta state verification failed: "
+            f"{sum(mismatches.values())} elements differ; top offenders: {offenders}"
+        )
+
+    logging.getLogger(__name__).warning(
+        "DELTA-VERIFY params=%d skipped_nonlocal_experts=%d "
+        "skipped_nonlocal_pipeline=%d mismatch_elems=0",
+        verified_params,
+        skipped_nonlocal_experts,
+        skipped_nonlocal_pipeline,
+    )
+
+
+_LAYER_INDEX_RE = re.compile(r"(?:^|\.)layers\.(\d+)\.")
+
+
+def _is_pipeline_missing_weight(model: torch.nn.Module, name: str) -> bool:
+    """Return whether an HF-global weight belongs to another PP stage."""
+    core = getattr(model, "model", model)
+    match = _LAYER_INDEX_RE.search(name)
+    if match is not None:
+        start_layer = getattr(core, "start_layer", None)
+        end_layer = getattr(core, "end_layer", None)
+        if start_layer is not None and end_layer is not None:
+            layer_index = int(match.group(1))
+            return not (start_layer <= layer_index < end_layer)
+
+    if "embed_tokens" in name:
+        return type(getattr(core, "embed_tokens", None)).__name__ == "PPMissingLayer"
+    if name.startswith("lm_head.") or ".lm_head." in name:
+        return type(getattr(model, "lm_head", None)).__name__ == "PPMissingLayer"
+    return False
