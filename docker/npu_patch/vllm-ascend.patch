+def test_npu_moment_checksum_detects_payload_changes():
+    positions = torch.tensor([0, 3, 9], dtype=torch.int32).view(torch.uint8)
+    values = torch.tensor([1.0, -2.0, 4.0], dtype=torch.bfloat16)
+    expected = _delta_checksum(positions, values, algorithm="npu_moment_v1")
+    assert expected == _delta_checksum(positions.clone(), values.clone(), algorithm="npu_moment_v1")
+
+    changed_positions = positions.clone().view(torch.int32)
+    changed_positions[1] += 1
+    assert _delta_checksum(
+        changed_positions.view(torch.uint8), values, algorithm="npu_moment_v1"
+    ) != expected
+
+    changed_values = values.clone()
+    changed_values[1] += 1
+    assert _delta_checksum(positions, changed_values, algorithm="npu_moment_v1") != expected
+
