--- a/contrib/torch_memory_saver/csrc/api_forwarder.h
+++ b/contrib/torch_memory_saver/csrc/api_forwarder.h
@@ -2,7 +2,20 @@
 #include <acl/acl.h>
 #include <dlfcn.h>
 namespace APIForwarder {
+
+// Loading CANN before Python starts changes its initial signal handlers and
+// breaks Ray's deferred SIGINT handling. Resolve ACL functions on first use.
+void *get_runtime_function(const char *name);
 aclError call_real_aclrt_malloc_align32(void **ptr, size_t size,
                                         aclrtMemMallocPolicy policy);
 aclError call_real_aclrt_free(void *ptr);
 } // namespace APIForwarder
+
+// Cache each symbol at its call site. decltype only uses the ACL declaration;
+// no link-time dependency on libascendcl is introduced.
+#define TMS_CANN_CALL(function, ...)                                           \
+  ([&]() {                                                                     \
+    static auto callable = reinterpret_cast<decltype(&::function)>(              \
+        APIForwarder::get_runtime_function(#function));                         \
+    return callable(__VA_ARGS__);                                               \
+  }())
diff --git a/contrib/torch_memory_saver/csrc/api_forwarder.cpp b/contrib/torch_memory_saver/csrc/api_forwarder.cpp
